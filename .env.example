# Sao chép thành .env rồi đổi giá trị. Server đọc biến môi trường của tiến trình;
# nạp file này bằng: node --env-file=.env ... hoặc đặt biến trong shell.

# Địa chỉ lắng nghe. Giữ 127.0.0.1 nếu chỉ dùng trên máy mình.
# Đổi sang địa chỉ khác thì BẮT BUỘC đặt MUSE_ACCESS_TOKEN, nếu không server từ chối khởi động.
HOST=127.0.0.1
PORT=8787

# Mã truy cập của chủ sở hữu workspace. Để trống = không yêu cầu đăng nhập (chỉ an toàn khi HOST là loopback).
MUSE_ACCESS_TOKEN=

# Thư mục dữ liệu (SQLite, ảnh, video). Mặc định: ./data
MUSE_DATA_DIR=

# Thư mục chứa khóa mã hóa credential. PHẢI nằm ngoài MUSE_DATA_DIR.
# Mặc định: %APPDATA%\muse-batch-manager (Windows) hoặc ~/.config/muse-batch-manager.
MUSE_KEY_DIR=

# Hoặc đưa khóa vào biến môi trường (32 byte, base64). Ưu tiên hơn file khóa.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MUSE_MASTER_KEY=

# Origin được phép gọi API khi chạy sau reverse proxy, phân tách bằng dấu phẩy.
MUSE_ALLOWED_ORIGINS=

# Adapter nền tảng: "muse" (tạo video thật trên muse.ai bằng Chrome) hoặc "mock" (mô phỏng, video mẫu).
MUSE_ADAPTER=mock
MUSE_MOCK_JOB_SECONDS=14
MUSE_MOCK_FAIL_RATE=0.05

# --- Adapter "muse": chọn MỘT cách đăng nhập ---
# 1) Profile riêng của app (khuyến nghị): đăng nhập Muse một lần, phiên được giữ lại. Chỉ 1 tài khoản.
MUSE_PROFILE_DIR=
# 2) Gắn vào Chrome đang chạy với --remote-debugging-port=9222 (Chrome 136+ yêu cầu --user-data-dir riêng). Chỉ 1 tài khoản.
MUSE_CDP=
# 3) Để trống cả hai: app tự mở Chrome và nạp cookie của từng tài khoản trong Account Pool (cần đủ cookie HttpOnly).
MUSE_CHANNEL=chrome
MUSE_HEADLESS=
MUSE_PLATFORM_URL=https://muse.ai/
MUSE_LOGIN_WAIT_MS=300000
MUSE_MAX_WAIT_MS=1800000
MUSE_IDLE_GRACE_MS=120000
# Đặt 1 để lưu ảnh chụp màn hình Muse khi job lỗi (data/muse-debug), dùng đối chiếu selector.
MUSE_DEBUG=

# Chỉ bật khi cần điều khiển session mô phỏng để nghiệm thu AC-08 (đặt 1 để bật).
MUSE_DEV_ROUTES=
